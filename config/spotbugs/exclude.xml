<?xml version="1.0" encoding="UTF-8"?>
<!-- Findings excluded on purpose; each one says why. -->
<FindBugsFilter>
    <!-- Mutable state is the contract here: Spring binds the configuration properties through getters and
         setters, Logback and JBoss events hand out their own arrays and maps, and alerts carry the Throwable. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Generated by the Quarkus annotation processor. -->
    <Match>
        <Class name="~.*\$\$accessor"/>
    </Match>

    <!-- The raw arguments are not serialized on purpose: they may hold data that is not masked yet. -->
    <Match>
        <Class name="co.com.pragma.logging.quarkus.slf4j.Slf4jLogRecord"/>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
    </Match>

    <!-- SLF4J's AbstractLogger.readResolve() replaces a deserialized logger with LoggerFactory.getLogger(name). -->
    <Match>
        <Class name="co.com.pragma.logging.quarkus.slf4j.PragmaSlf4jLogger"/>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
    </Match>
</FindBugsFilter>
